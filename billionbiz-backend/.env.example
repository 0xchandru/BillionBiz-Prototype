# BillionBiz Backend Environment Template
# Copy to .env and configure for your environment

# Application Runtime
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Database Connection (PostgreSQL 16+)
DATABASE_URL=postgres://user:password@localhost:5432/billionbiz

# Authentication (Minimum 32-character high-entropy secret)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
BCRYPT_ROUNDS=10

# CORS Allowed Origins (Comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=https://chandraprakash.codes,https://admin.chandraprakash.codes,https://accounts.chandraprakash.codes,https://staff.chandraprakash.codes,https://pos.chandraprakash.codes,https://ops.chandraprakash.codes,http://localhost:5173,http://localhost:3000

# Public URLs
APP_URL=https://chandraprakash.codes
API_BASE_URL=https://api.chandraprakash.codes
TUNNEL_URL=

# Transactional Email Providers: console | smtp | resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BillionBiz <noreply@chandraprakash.codes>

# Platform Security: 32-byte Hex Key Encryption Key for tenant provider envelope encryption
# Owner: PLATFORM (never put merchant provider credentials here)
INTEGRATION_CREDENTIALS_KEK=

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


