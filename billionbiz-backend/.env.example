# BillionBiz Backend Environment Template
# Copy to .env and configure for your environment

NODE_ENV=development
PORT=8080
NODE_ENV=development
# Optional paths for the local per-store React project manager.
# BILLIONBIZ_FRONTEND_ROOT=../billionbiz-frontend
# BILLIONBIZ_STORE_PROJECTS_DIR=./store-projects
# BILLIONBIZ_STORE_PROJECT_SYNC_MS=10000
HOST=0.0.0.0

# Database Connection (PostgreSQL 16+)
DATABASE_URL=postgres://user:password@localhost:5432/billionbiz

# Authentication (Minimum 32-character high-entropy secret)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
BCRYPT_ROUNDS=10

# Canonical Domain Architecture
ROOT_DOMAIN=chandraprakash.codes
MAIN_WEBSITE_URL=https://www.chandraprakash.codes
ADMIN_URL=https://admin.chandraprakash.codes
ACCOUNTS_URL=https://accounts.chandraprakash.codes
STAFF_URL=https://staff.chandraprakash.codes
POS_URL=https://pos.chandraprakash.codes
OPS_URL=https://ops.chandraprakash.codes
API_URL=https://api.chandraprakash.codes
API_BASE_URL=https://api.chandraprakash.codes/api/v1
STORE_DOMAIN_PATTERN=*.chandraprakash.codes
# DNS target for real storefront domain verification. Configure the wildcard
# record in Cloudflare to point at the deployed shared storefront runtime.
STORE_DOMAIN_CNAME_TARGET=
APP_URL=https://www.chandraprakash.codes

# Security & CORS Allowed Origins
ALLOWED_ORIGINS=https://www.chandraprakash.codes,https://admin.chandraprakash.codes,https://accounts.chandraprakash.codes,https://staff.chandraprakash.codes,https://pos.chandraprakash.codes,https://ops.chandraprakash.codes
CORS_ALLOWED_ORIGINS=https://chandraprakash.codes,https://www.chandraprakash.codes,https://admin.chandraprakash.codes,https://accounts.chandraprakash.codes,https://staff.chandraprakash.codes,https://pos.chandraprakash.codes,https://ops.chandraprakash.codes,https://api.chandraprakash.codes,http://localhost:5173,http://localhost:3000

# Transactional Email Providers: console | smtp | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BillionBiz <noreply@chandraprakash.codes>

# Platform Security: 32-byte Hex Key Encryption Key for tenant provider envelope encryption
INTEGRATION_CREDENTIALS_KEK=

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudflare R2 storefront media uploads (keep the secret out of source control).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_MAX_UPLOAD_BYTES=10485760
